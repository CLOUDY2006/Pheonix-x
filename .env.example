# ============================================================================
#  PHOENIX X configuration. Copy to .env. Every value is optional.
#  Two modes:
#    demo        (default)  simulated enterprise + attack simulation button + demo logins. Safe to show off.
#    production             NO simulated data. Real logs in via /api/ingest. Every containment action needs a human
#                           approval. First visit creates your administrator account.
# ============================================================================
PHOENIX_MODE=demo
PORT=3000
HOST=127.0.0.1                  # keep loopback unless TLS or a reverse proxy sits in front
PHOENIX_DB=./data/phoenix.db    # SQLite file (persistent). Back it up: npm run backup
PHOENIX_BACKUP_DIR=./data/backups
PHOENIX_BACKUP_EVERY_HOURS=0    # >0 = automatic online backup every N hours
PHOENIX_RETENTION_DAYS=30       # raw events older than this are purged (incidents + audit are kept)

# ---- Production hardening ----
PHOENIX_SETUP_TOKEN=            # if set, first-run admin creation requires this token (recommended when exposed)
PHOENIX_REQUIRE_ADMIN_TOTP=off  # on = admins must enrol an authenticator app (RFC 6238 TOTP)
PHOENIX_SESSION_HOURS=8
PHOENIX_IDLE_MINUTES=60
PHOENIX_TRUST_PROXY=off         # on when behind Caddy/nginx/ALB (uses X-Forwarded-For for client IPs)
PHOENIX_COOKIE_SECURE=          # default: on in production. Set "off" only for plain-http localhost testing
PHOENIX_ALLOWED_ORIGINS=        # extra WebSocket origins, comma separated (same-origin is always allowed)
PHOENIX_TLS_CERT=               # optional built-in TLS (PEM paths). Otherwise terminate TLS in a proxy.
PHOENIX_TLS_KEY=
PHOENIX_METRICS_TOKEN=          # Bearer token for Prometheus scraping /metrics
PHOENIX_LOG_LEVEL=info

# ---- Behaviour (production defaults shown) ----
PHOENIX_AUTO_CONTAIN=off        # demo default on. off = even "low-risk" actions need approval
PHOENIX_APPROVAL_TIMEOUT_MIN=30 # unanswered approvals are auto-DENIED (fail-safe). 0 = wait forever
PHOENIX_BUSINESS_HOURS=8-18     # for off-hours anomaly scoring (local to PHOENIX_UTC_OFFSET_HOURS)
PHOENIX_UTC_OFFSET_HOURS=0
PHOENIX_BASELINE_LOGINS=3       # clean logins before a new user's "home country" is learned
# Detection thresholds (PHOENIX_TH_*): see docs/INTEGRATIONS.md

# ---- Demo-only switches (refused / ignored in production) ----
PHOENIX_SEED_DEMO_USERS=        # default on in demo: admin / analyst / viewer, password "phoenix-demo"
PHOENIX_ADMIN_PASSWORD=         # override the demo passwords
PHOENIX_ANALYST_PASSWORD=
PHOENIX_VIEWER_PASSWORD=
PHOENIX_GENERATOR=              # synthetic background traffic (default on in demo)
PHOENIX_PACE_MS=1000

# ---- Containment connectors: how GUARDIAN touches the real world ----
# none = nothing connected, a human applies it (the UI makes it a task). Production default.
# Live connectors start in DRY-RUN: they log what they WOULD do. Set PHOENIX_CONNECTOR_DRYRUN=off to go live.
PHOENIX_CONNECTOR_DRYRUN=on
PHOENIX_CONNECTOR_IDENTITY=none     # none | okta | entra | webhook
PHOENIX_CONNECTOR_NETWORK=none      # none | webhook   (firewall / WAF block_ip)
PHOENIX_CONNECTOR_ENDPOINT=none     # none | webhook   (EDR isolate_host)
PHOENIX_CONNECTOR_DATA=none         # none | webhook
PHOENIX_CONNECTOR_CLOUD=none        # none | webhook
OKTA_URL=                           # https://your-org.okta.com
OKTA_API_TOKEN=                     # token with user lifecycle + session permissions
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=                # app needs User.ReadWrite.All (Graph, application permission)
PHOENIX_WEBHOOK_URL=                # generic signed webhook (also PHOENIX_WEBHOOK_URL_NETWORK, _ENDPOINT, _IDENTITY, _DATA, _CLOUD)
PHOENIX_WEBHOOK_SECRET=             # HMAC-SHA256 signing secret -> header X-Phoenix-Signature

# ---- Threat intelligence / AI ----
VT_API_KEY=                         # VirusTotal; otherwise local sample DB (unknown is never treated as malicious)
ANTHROPIC_API_KEY=                  # optional prose briefing on top of structured facts (never changes evidence)
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Notifications (a message counts as delivered only if the provider confirms it) ----
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_TO=

# ---- Ticketing (Jira Cloud) ----
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=
JIRA_ISSUE_TYPE=Task
JIRA_ASSIGNEE_ID=

# ---- Supabase (optional mirror of events/incidents/audit; server-side key only) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PHOENIX_SUPABASE_USER_MAP={}

# ---- AI autonomy (see docs/AUTONOMY.md) ----
# watch = AI recommends, humans approve | balanced = AI blocks/revokes alone | full = AI also does cautious actions
PHOENIX_AUTONOMY=
PHOENIX_AI_ACTION_BUDGET=25      # max automatic actions per rolling hour (circuit breaker)
PHOENIX_SWEEP_SEC=60             # how often the AI lifts its own expired blocks

# ---- Pull collectors ----
PHOENIX_SECRET_KEY=              # >=16 chars; encrypts stored API tokens (otherwise data/.secret is generated)
PHOENIX_POLL_SEC=15              # scheduler tick (each collector has its own interval)

# ---- Chat assistant ----
PHOENIX_CHAT_LLM=off             # on = unanswered questions go to the model (needs ANTHROPIC_API_KEY); it can never run actions

# Recovery verification probes refuse private/internal addresses (SSRF guard). Set to 1 only for self-hosted/internal targets or tests.
PHOENIX_VERIFY_ALLOW_PRIVATE=0
# Override provider API bases (tests/mocks): PHOENIX_API_SUPABASE, PHOENIX_API_VERCEL, PHOENIX_API_RENDER, PHOENIX_API_NETLIFY, PHOENIX_API_HEROKU, PHOENIX_API_GITHUB

# Public https URL of this server (used for links in chat alerts and for Slack/Discord inbound URLs)
PHOENIX_PUBLIC_URL=
# Run a recovery-readiness "game day" automatically every N hours (0 = off, 168 = weekly)
PHOENIX_GAMEDAY_HOURS=0
# Telegram polling interval in seconds
PHOENIX_CHANNEL_POLL_SEC=3
